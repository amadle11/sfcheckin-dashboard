# Copy to .env.local for local development.

# Auth.js: a long random string (run: npx auth secret)
AUTH_SECRET=
# Google OAuth client (Google Cloud console > APIs & Services > Credentials)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_TRUST_HOST=true

# Comma-separated emails that are always Admin. Everyone else must be added on the Admin page.
ADMIN_EMAILS=

# Where users and projects are stored: "firestore" in production, "file" for local dev.
STORE=file
# Only for STORE=file
DATA_FILE=.data/store.json

# BigQuery project with the check-in data
BQ_PROJECT=sigfit

# Optional: email watchers when a project changes. Without it, notifications are skipped.
# Example: smtps://user:app-password@smtp.gmail.com:465
SMTP_URL=
MAIL_FROM=
# Public URL of the app, used for links in emails
APP_URL=

# Local dev only: skip Google sign-in and act as this email. Ignored in production.
DEV_LOGIN_EMAIL=
